# Unité utilisateur systemd pour Iris.
# `iris service install` génère une copie avec le bon chemin dans ~/.config/systemd/user/.
# Installation manuelle :
#   cp systemd/iris.service ~/.config/systemd/user/ && systemctl --user enable --now iris
[Unit]
Description=Iris — assistant vocal pour Omarchy OS
Documentation=https://github.com/belzeeebuth/irisai
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/iris run
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
# Le modèle Whisper fragmente beaucoup le tas : sans ce seuil, la glibc conserve
# ~300 Mo déjà libérés au lieu de les rendre au système.
Environment=MALLOC_TRIM_THRESHOLD_=131072
Slice=background.slice
Nice=5

[Install]
WantedBy=graphical-session.target
